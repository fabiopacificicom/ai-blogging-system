{
  "name": "pacificdev/autonomous-blogging-system",
  "description": "Automated AI-Powered Blogging and Sharing System",
  "type": "library",
  "version": "1.0.0",
  "keywords": [
    "laravel",
    "ai",
    "blogging",
    "cms"
  ],
  "authors": [
    {
      "name": "fbhood",
      "email": "mail@fabiopacifici.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "PacificDev\\BlogAi\\": "src/",
      "PacificDev\\BlogAi\\Commands\\": "src/app/Commands/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "PacificDev\\BlogAi\\PacificDevServiceProvider"
      ]
    }
  },
  "require": {
    "php": "^8.2",
    "illuminate/support": "*",
    "pacificdev/laravel_9_preset": "^1.3",
    "livewire/livewire": "^3.3",
    "laravel/scout": "^10.8",
    "spatie/image-optimizer": "^1.7"
  },
  "require-dev": {
    "laravel/breeze": "^1.16"
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}